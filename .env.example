# LLM provider for the agent: anthropic | ollama | fake (replays recorded responses; used by tests/CI)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Free local alternative:  LLM_PROVIDER=ollama  (ollama pull qwen2.5:7b)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
RETAILPULSE_FORECAST_API_URL=http://localhost:8001
